# Cabeçalhos de segurança enviados pelo Cloudflare Pages (o GitHub Pages não deixa configurar isso).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://ztmwsvfqlozilwnqkrom.supabase.co wss://ztmwsvfqlozilwnqkrom.supabase.co https://cdn.jsdelivr.net; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# O service worker e a página sempre conferem se há versão nova
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
